    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.22.0",
    "@sourcing/shared": "*",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "helmet": "^8.0.0",
    "otplib": "^12.0.1",
    "reflect-metadata": "^0.2.2",
