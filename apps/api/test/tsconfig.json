{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "allowJs": true,
    "isolatedModules": true,
    "baseUrl": ".."
  },
  "include": ["**/*.ts", "../src/**/*.ts"]
}
