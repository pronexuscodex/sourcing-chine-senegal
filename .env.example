# Copy to .env in each app that needs it. Never commit the real .env.

# --- Database (apps/api) ---
DATABASE_URL="postgresql://user:password@localhost:5432/sourcing_dev"

# --- Redis (apps/api) ---
REDIS_URL="redis://localhost:6379"

# --- Auth (apps/api) ---
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Object storage (apps/api) — Cloudflare R2 (S3-compatible), see ARCHITECTURE.md §20 ---
# "local" (default, dev/test only — writes to apps/api/.uploads, never used in production) or "s3".
STORAGE_PROVIDER="local"
API_PUBLIC_URL="http://localhost:4000"
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Payments (apps/api) — see ARCHITECTURE.md §20 ---
# "mock" (default, dev/test only — blocked outside NODE_ENV=production) or "cinetpay".
PAYMENT_PROVIDER="mock"
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_NOTIFY_URL=""

# --- WhatsApp Cloud API (apps/api) ---
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""

# --- Email (apps/api) ---
EMAIL_PROVIDER_API_KEY=""

# --- App (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
